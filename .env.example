# ==========================================
# Configurações do GitHub para o AutoGest
# Utilizado por: scripts/sync-projects.ts
# ==========================================

# Token de Acesso Pessoal (PAT) do GitHub.
# OBRIGATÓRIO: Classic Token (Tokens classic) com os escopos 'repo' e 'project'.
# NOTA: O GitHub Projects v2 (API GraphQL) NÃO oferece suporte a Fine-grained PATs (github_pat_...).
# Link rápido pré-configurado: https://github.com/settings/tokens/new?scopes=repo,project&description=AutoGest+Project+Sync
GH_PROJECT_TOKEN=

# Identificação do Repositório
REPO_OWNER=lais-zanardi
REPO_NAME=autogest

# Identificação do GitHub Projects (Projects v2)
# PROJECT_OWNER: Dono do Project (pode ser o mesmo de REPO_OWNER ou o nome de uma organização)
PROJECT_OWNER=lais-zanardi

# Tipo do dono do projeto: 'USER' (perfil pessoal) ou 'ORGANIZATION' (organização)
PROJECT_OWNER_TYPE=USER

# Número do GitHub Project (inteiro positivo, presente na URL do projeto, ex: 1)
PROJECT_NUMBER=
