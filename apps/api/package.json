{
  "name": "@autogest/api",
  "version": "1.0.0",
  "description": "Backend API RESTful em Node.js e Express para AutoGest",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate": "ts-node-dev --transpile-only src/database/migrator.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@autogest/shared-types": "*",
    "@google-cloud/storage": "^7.22.0",
    "@types/pdfkit": "^0.17.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "firebase-admin": "^12.7.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
