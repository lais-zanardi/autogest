# ==========================================
# AutoGest API - Variáveis de Ambiente
# ==========================================

# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autogest

# Firebase Authentication (Admin SDK)
# Em ambiente de produção, preencher com as credenciais da Service Account do Firebase Console
FIREBASE_PROJECT_ID=autogest-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Cloud Storage (GCS)
# Armazenamento de comprovantes fiscais e relatórios
GCS_BUCKET_NAME=autogest-dev-storage
GCS_PROJECT_ID=autogest-dev
GCS_KEY_FILE=

# Serviços Externos
OPENWEATHER_API_KEY=
ANP_API_URL=https://dados.gov.br/dados/conjuntos-dados/serie-historica-de-precos-de-combustiveis-por-revenda
